# Shared B200 defaults. Every value remains overrideable from the environment.
DATA_ROOT="${DATA_ROOT:-/workspace/storage-shared/nlp/minhpn19/data}"
DATASET="${DATASET:-simplelr}"
DATASET_PATH="${DATASET_PATH:-}"
TRAIN_DATA_FRACTION="${TRAIN_DATA_FRACTION:-1.0}"
TRAIN_SUBSET_SEED="${TRAIN_SUBSET_SEED:-42}"
MAX_TRAIN_SAMPLES="${MAX_TRAIN_SAMPLES:-0}"

PRETRAIN_DATASET="${PRETRAIN_DATASET:-sharegpt}"
PRETRAIN_DATASET_PATH="${PRETRAIN_DATASET_PATH:-}"
PRETRAIN_EPOCHS="${PRETRAIN_EPOCHS:-1}"
PRETRAIN_LR="${PRETRAIN_LR:-5e-5}"
PRETRAIN_BATCH_SIZE="${PRETRAIN_BATCH_SIZE:-4}"
PRETRAIN_ATTENTION_BACKEND="${PRETRAIN_ATTENTION_BACKEND:-}"
PRETRAIN_DISTRIBUTED_MODE="${PRETRAIN_DISTRIBUTED_MODE:-auto}"
PRETRAIN_LENGTH_BUCKETING="${PRETRAIN_LENGTH_BUCKETING:-true}"
PRETRAIN_LENGTH_BUCKET_BOUNDARIES="${PRETRAIN_LENGTH_BUCKET_BOUNDARIES:-[512,768,1024,1280,1536,1792,2048]}"
PRETRAIN_DATALOADER_WORKERS="${PRETRAIN_DATALOADER_WORKERS:-8}"
PRETRAIN_COMPACT_TEACHER="${PRETRAIN_COMPACT_TEACHER:-false}"
PRETRAIN_OPTIMIZER_CPU_OFFLOAD="${PRETRAIN_OPTIMIZER_CPU_OFFLOAD:-false}"
PRETRAIN_ACCUMULATION_STEPS="${PRETRAIN_ACCUMULATION_STEPS:-1}"
PRETRAIN_MAX_LENGTH="${PRETRAIN_MAX_LENGTH:-2048}"
PRETRAIN_SAVE_INTERVAL="${PRETRAIN_SAVE_INTERVAL:-500}"
PRETRAIN_MAX_SAMPLES="${PRETRAIN_MAX_SAMPLES:-0}"

NUM_EPOCHS="${NUM_EPOCHS:-1}"
SAMPLE_NUM="${SAMPLE_NUM:-100}"
GRPO_ITERATION_NUM="${GRPO_ITERATION_NUM:-1}"
REPEATED_GENERATE_NUMS="${REPEATED_GENERATE_NUMS:-8}"
RESPONSES_PER_PROMPT="${RESPONSES_PER_PROMPT:-${REPEATED_GENERATE_NUMS:-8}}"
TEMPERATURE="${TEMPERATURE:-1.0}"
TOP_P="${TOP_P:-0.95}"
GEN_MAX_LENGTH="${GEN_MAX_LENGTH:-2048}"
MAX_PROMPT_LENGTH="${MAX_PROMPT_LENGTH:-2048}"
LOGPS_CHUNK_SIZE="${LOGPS_CHUNK_SIZE:-256}"

TARGET_LR="${TARGET_LR:-1e-6}"
DRAFT_LR="${DRAFT_LR:-1e-4}"
DRAFT_ACCUMULATION_STEPS="${DRAFT_ACCUMULATION_STEPS:-1}"
BETA="${BETA:-0.04}"
EPSILON="${EPSILON:-0.1}"
TARGET_ADAPTER="${TARGET_ADAPTER:-}"
IS_TRAIN_DRAFT="${IS_TRAIN_DRAFT:-True}"

METHOD="${METHOD:-fastgrpo}"
case "$METHOD" in
  fastgrpo|opd_reflex) ;;
  *) echo "ERROR: METHOD must be fastgrpo or opd_reflex, got: $METHOD" >&2; return 2 2>/dev/null || exit 2 ;;
esac
export OPD_RANK="${OPD_RANK:-8}"
export OPD_TOPK="${OPD_TOPK:-16}"
export OPD_FAST_LR="${OPD_FAST_LR:-${FAST_LR:-0.01}}"
export OPD_VISITED_WEIGHT="${OPD_VISITED_WEIGHT:-1.0}"
export OPD_FRONTIER_WEIGHT="${OPD_FRONTIER_WEIGHT:-1.0}"
# User-observed fastest B200/Qwen2.5-3B sweep configuration; still overrideable.
export OPD_UPDATE_STREAM="${OPD_UPDATE_STREAM:-1}"
export OPD_PROFILE="${OPD_PROFILE:-0}"
export OPD_DIAGNOSTICS="${OPD_DIAGNOSTICS:-0}"
export OPD_BACKEND="${OPD_BACKEND:-triton}"
export OPD_TRAIN_PROJECTOR="${OPD_TRAIN_PROJECTOR:-1}"
export OPD_PROJECTOR_LR="${OPD_PROJECTOR_LR:-}"
export ROLLOUT_LOG_FLUSH_INTERVAL="${ROLLOUT_LOG_FLUSH_INTERVAL:-1}"
export OPD_PROPOSAL_MODE="${OPD_PROPOSAL_MODE:-auto}"
export OPD_DENSE_IMPLEMENTATION="${OPD_DENSE_IMPLEMENTATION:-auto}"
export OPD_PROPOSAL_PROFILE="${OPD_PROPOSAL_PROFILE:-}"
export OPD_AUTO_TUNE_IF_MISSING="${OPD_AUTO_TUNE_IF_MISSING:-0}"
export OPD_KV_MAX_RETAINED_TOKENS="${OPD_KV_MAX_RETAINED_TOKENS:-0}"
DRAFT_TRAIN_MODE="${DRAFT_TRAIN_MODE:-batched}"
DRAFT_TRAIN_MAX_BATCH_SIZE="${DRAFT_TRAIN_MAX_BATCH_SIZE:-8}"
DRAFT_TRAIN_MAX_TOKENS="${DRAFT_TRAIN_MAX_TOKENS:-2048}"
DRAFT_TRAIN_MAX_PADDING_RATIO="${DRAFT_TRAIN_MAX_PADDING_RATIO:-1.25}"
DRAFT_TRAIN_PROFILE="${DRAFT_TRAIN_PROFILE:-0}"
KV_GATHER_STRATEGY="${KV_GATHER_STRATEGY:-stacked}"

VERIFICATION_CAPACITY="${VERIFICATION_CAPACITY:-512}"
MAX_VERIFICATION_NUM="${MAX_VERIFICATION_NUM:-512}"
MAX_DRAFT_TOKEN_LENGTH="${MAX_DRAFT_TOKEN_LENGTH:-5}"
MAX_DRAFT_K="${MAX_DRAFT_K:-8}"
MIN_DRAFT_TOKEN_LENGTH="${MIN_DRAFT_TOKEN_LENGTH:-3}"
DRAFT_TOKEN_LENGTH_C="${DRAFT_TOKEN_LENGTH_C:-0.75}"

NUM_WORKERS="${NUM_WORKERS:-0}"
PERSISTENT_WORKERS="${PERSISTENT_WORKERS:-false}"
KEEP_LAST_CHECKPOINTS="${KEEP_LAST_CHECKPOINTS:-3}"
SAVE_CHECKPOINT_STEPS="${SAVE_CHECKPOINT_STEPS:-100}"
RESUME="${RESUME:-}"
NPROC_PER_NODE="${NPROC_PER_NODE:-1}"
CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
MODEL_DTYPE="${MODEL_DTYPE:-bf16}"
ATTENTION_IMPLEMENTATION="${ATTENTION_IMPLEMENTATION:-sdpa}"
STATISTICAL_TIME="${STATISTICAL_TIME:-False}"
LOG_INTERVAL="${LOG_INTERVAL:-1}"
